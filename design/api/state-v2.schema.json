        "version",
        "id",
        "week",
        "type",
        "actors",
        "project",
        "room",
        "data"
      ],
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mean": {
          "type": "number"
        },
        "low": {
          "type": "number"
        },
        "high": {
          "type": "number"
        },
        "observations": {
          "type": "integer"
        }
      },
      "required": [
        "key",
        "name",
        "mean",
        "low",
        "high",
        "observations"
      ],
      "additionalProperties": false
