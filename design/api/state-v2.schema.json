{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LucasYL/drugstory/api/state-v2",
  "title": "GameState",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "api_version": {
      "const": 2
    },
    "event_cursor": {
      "type": "integer"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Event"
      }
    },
    "transition_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Event"
      }
    },
    "equipment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/RoomId"
          },
          "profession": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "cost": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "available": {
            "type": "boolean"
          },
          "text": {
            "type": "string"
          },
          "upkeep": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "profession",
          "name",
          "level",
          "cost",
          "available",
          "text",
          "upkeep"
        ],
        "additionalProperties": false
      }
    },
    "notebook": {
      "$ref": "#/$defs/JsonValue"
    },
    "challenge": {
      "$ref": "#/$defs/JsonValue"
    },
    "market_capacity": {
      "$ref": "#/$defs/JsonValue"
    },
    "date": {
      "type": "string"
    },
    "week": {
      "type": "integer"
    },
    "cash": {
      "type": "number"
    },
    "committed": {
      "type": "number"
    },
    "available_cash": {
      "type": "number"
    },
    "runway": {
      "$ref": "#/$defs/JsonValue"
    },
    "payroll": {
      "type": "number"
    },
    "costs_per_week": {
      "type": "number"
    },
    "weekly_profit": {
      "type": "number"
    },
    "weekly_royalty": {
      "type": "number"
    },
    "reputation": {
      "type": "number"
    },
    "knowledge": {
      "$ref": "#/$defs/JsonValue"
    },
    "facility": {
      "$ref": "#/$defs/JsonValue"
    },
    "next_facility": {
      "$ref": "#/$defs/JsonValue"
    },
    "headcount": {
      "type": "integer"
    },
    "clinical_used": {
      "type": "integer"
    },
    "lines_used": {
      "type": "integer"
    },
    "scenario": {
      "type": "string"
    },
    "opening": {
      "$ref": "#/$defs/JsonValue"
    },
    "goals": {
      "$ref": "#/$defs/JsonValue"
    },
    "objective_done": {
      "type": "boolean"
    },
    "heroes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Hero"
      }
    },
    "roster": {
      "$ref": "#/$defs/JsonValue"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Project"
      }
    },
    "products": {
      "$ref": "#/$defs/JsonValue"
    },
    "deals": {
      "$ref": "#/$defs/JsonValue"
    },
    "rivals": {
      "$ref": "#/$defs/JsonValue"
    },
    "honors": {
      "$ref": "#/$defs/JsonValue"
    },
    "orders": {
      "$ref": "#/$defs/JsonValue"
    },
    "jobs": {
      "$ref": "#/$defs/JsonValue"
    },
    "journal": {
      "$ref": "#/$defs/JsonValue"
    },
    "income": {
      "$ref": "#/$defs/JsonValue"
    },
    "expense": {
      "$ref": "#/$defs/JsonValue"
    },
    "report": {
      "$ref": "#/$defs/JsonValue"
    },
    "game_over": {
      "type": "boolean"
    },
    "negative_months": {
      "type": "integer",
      "description": "连续几个月月底现金为负；到 3 停业"
    },
    "career_done": {
      "type": "boolean"
    },
    "pending": {
      "type": "integer"
    },
    "catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "competition": {
            "type": "number"
          },
          "announced_rivals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "boolean"
            }
          },
          "unlocked": {
            "type": "boolean"
          },
          "occupied": {
            "type": "boolean"
          },
          "discovery": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "tier": {
                    "type": "integer"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "week": {
                    "type": "integer"
                  }
                },
                "required": [
                  "tier",
                  "reason",
                  "week"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "key",
          "competition",
          "announced_rivals",
          "requirements",
          "unlocked",
          "occupied",
          "discovery"
        ],
        "additionalProperties": false
      }
    },
    "revision": {
      "type": "integer"
    },
    "token": {
      "type": "string"
    },
    "saved_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "display_scale": {
      "const": 10
    },
    "patents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Patent"
      }
    },
    "assist": {
      "$ref": "#/$defs/Assist"
    },
    "rating": {
      "$ref": "#/$defs/Rating"
    }
  },
  "required": [
    "version",
    "api_version",
    "event_cursor",
    "events",
    "transition_events",
    "equipment",
    "notebook",
    "challenge",
    "market_capacity",
    "date",
    "week",
    "cash",
    "committed",
    "available_cash",
    "runway",
    "payroll",
    "costs_per_week",
    "weekly_profit",
    "weekly_royalty",
    "reputation",
    "knowledge",
    "facility",
    "next_facility",
    "headcount",
    "clinical_used",
    "lines_used",
    "scenario",
    "opening",
    "goals",
    "objective_done",
    "heroes",
    "roster",
    "projects",
    "products",
    "deals",
    "rivals",
    "honors",
    "orders",
    "jobs",
    "journal",
    "income",
    "expense",
    "report",
    "game_over",
    "career_done",
    "pending",
    "catalog",
    "revision",
    "token",
    "saved_at",
    "display_scale",
    "patents",
    "assist",
    "negative_months",
