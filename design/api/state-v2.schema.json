            "type": "number"
          }
        },
        "planned": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "required": [
        "actor",
        "role",
        "members",
        "amounts"
      ],
      "additionalProperties": false
