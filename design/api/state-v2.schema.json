    "Event": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "id": {
          "type": "integer"
        },
        "week": {
          "type": "integer"
        },
        "type": {
          "enum": [
            "work_completed",
            "evidence_received",
            "phase_started",
            "phase_finished",
            "character_promoted",
            "personal_completed",
            "equipment_upgraded",
            "facility_upgraded",
            "product_launched",
            "service_completed",
            "deal_signed",
            "patent_filed",
            "patent_granted",
            "patent_expired",
            "milestone_reached",
            "award_won",
            "legacy_reached",
            "term_ended",
            "cash_changed",
            "notice"
          ]
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "room": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoomId"
